.env
Sources/.env
Sources/backend/.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Use the Conda environment `RAG`, not a virtual environment in this folder
.venv/
venv/

# Embedded Qdrant data (only when QDRANT_PATH is used instead of Docker)
Sources/backend/qdrant_data/

# Frontend
Sources/frontend/node_modules/
Sources/frontend/dist/
Sources/frontend/*.tsbuildinfo
node_modules/
dist/
*.tsbuildinfo
.vite/

# Logs, OS and editor files
.run/
*.log
.DS_Store
.idea/
.vscode/
.claude

# Crawled and benchmark data, report inputs, and bulky per-query results
data/HYU/raw/
data/benchmarks/*/*
!data/benchmarks/*/SOURCE.md
results/*/raw/
results/smoke*/
Report/course/
