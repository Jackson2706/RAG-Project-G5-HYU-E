# Copy to .env (project root) and change the password before `docker compose up -d`.
# Docker Compose reads this file; the backend reads backend/.env (see backend/.env.example).
MONGO_ROOT_USERNAME=hyu_admin
MONGO_ROOT_PASSWORD=change-me-locally
MONGO_PORT=27017
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Cloud alternatives
MONGO_URI=
MONGO_DB=hyu_compass
QDRANT_URL=
QDRANT_API_KEY=

LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-20b
