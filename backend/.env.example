# Copy to backend/.env. Every value has a working default for local development
# except the MongoDB credentials, which must match the project-level .env.

# --- MongoDB (Docker Compose service) ---
MONGODB_URI=mongodb://hyu_admin:change-me-locally@127.0.0.1:27017/?authSource=admin
MONGODB_DB=hyu_compass

# --- Qdrant ---
# Server mode (Docker Compose service):
QDRANT_URL=http://127.0.0.1:6333
# Docker-less fallback: Qdrant local mode (embedded, exact search, single process).
# When set, QDRANT_PATH takes precedence over QDRANT_URL.
# QDRANT_PATH=../data/qdrant_local
QDRANT_COLLECTION_PREFIX=hyu_chunks

# --- Embeddings (index contract defaults; see docs/HYPERPARAMETERS.md) ---
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_DEVICE=cpu

# --- Ollama (native API) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave empty to use the first installed model; must be a name from `ollama list`.
OLLAMA_CHAT_MODEL=
OLLAMA_REQUEST_TIMEOUT=120

# --- API ---
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
MAX_UPLOAD_MB=20
