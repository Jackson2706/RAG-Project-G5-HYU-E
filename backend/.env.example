# Copy to backend/.env and change the password. Every setting here is optional except the
# MongoDB password, which must match MONGO_ROOT_PASSWORD in the project-level .env file.
# (Setting names match the fields of `Settings` in backend/app/config.py.)

# --- MongoDB (started by docker compose) ---
MONGODB_URI=mongodb://hyu_admin:change-me-locally@127.0.0.1:27017/?authSource=admin
MONGODB_DB=hyu_compass

# --- Qdrant (started by docker compose) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=hyu_chunks
# Without Docker: store Qdrant in a folder inside backend/ instead (one program at a time).
# QDRANT_PATH=qdrant_data

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# A model from `ollama list`. Empty = the first installed model.
OLLAMA_CHAT_MODEL=
