# Copy to .env (project root) and change the password before `docker compose up -d`.
# Docker Compose reads this file; the backend reads backend/.env (see backend/.env.example).
MONGO_ROOT_USERNAME=hyu_admin
MONGO_ROOT_PASSWORD=change-me-locally
MONGO_PORT=27017
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
