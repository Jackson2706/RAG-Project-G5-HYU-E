# Copy to Sources/backend/.env and change the password. Every setting here is optional except the
# MongoDB password, which must match MONGO_ROOT_PASSWORD in the project-level .env file.
# (Setting names match the fields of `Settings` in Sources/backend/app/config.py.)

# --- MongoDB (started by docker compose) ---
MONGODB_URI=mongodb://hyu_admin:change-me-locally@127.0.0.1:27017/?authSource=admin
MONGODB_DB=hyu_compass
# Cloud alternative:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/

# --- Qdrant (started by docker compose) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=hyu_chunks
QDRANT_API_KEY=
# Without Docker: store Qdrant in a folder inside backend/ instead (one program at a time).
# QDRANT_PATH=qdrant_data

# --- LLM provider ---
LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODELS=qwen/qwen3.8-27b,llama-3.1-8b-instant,openai/gpt-oss-20b,llama-3.3-70b-versatile

# --- Ollama (used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# A model from `ollama list`. Empty = the first installed model.
OLLAMA_CHAT_MODEL=

# --- Backend CORS ---
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
